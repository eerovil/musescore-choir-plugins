# The MuseScore 3 program. scripts/setup.sh finds it (or, on Linux, downloads the
# official 3.6.2 AppImage) and writes it into .env. Blank means `musescore3` on PATH.
# macOS: "/Applications/MuseScore 3.app/Contents/MacOS/mscore"
MUSESCORE_CLI_PATH=""
# The application "Open in MuseScore" asks macOS for. MuseScore 3 when left unset.
MUSESCORE_APP=""

# Optional: homr (optical music recognition), installed by scripts/install-homr.sh.
# Leave blank unless the venv is somewhere other than the script's default,
# ~/.local/share/musescore-choir-plugins/homr-venv.
HOMR_BIN=""

# Optional: map each song workspace to a normal AgentDeck chat.
# Browser-facing origin (what the AgentDeck button opens):
AGENTDECK_URL=""
# Server-facing origin; leave blank to use AGENTDECK_URL. A loopback URL is useful
# when the browser origin is behind HTTPS/auth but both apps run on the same host.
AGENTDECK_API_URL=""
# Exact AgentDeck account key to use when creating a song chat.
AGENTDECK_ACCOUNT_KEY=""

# Optional: publish songs to the Cloudflare stemmanauhat site (#382): the score,
# its MIDI and the timing go to its R2 bucket, the song to its D1 list.
# One API token with "R2 Storage: Edit" and "D1: Edit" on that account; blank
# turns the Publish button off.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
STEMMANAUHAT_D1_DATABASE_ID=""
# Leave blank for the bucket called "stemmanauhat".
STEMMANAUHAT_R2_BUCKET=""
